{
  "semantic_tools": {
    "MOVE_CURSOR": {
      "description": "Mover el cursor sin pulsar (hover, apuntar, seguir trayectoria).",
      "params": {
        "x": "int",
        "y": "int"
      }
    },
    "CLICK": {
      "description": "Pulsar un botón del ratón en una coordenada del espacio del screenshot.",
      "params": {
        "button": "str",
        "x": "int",
        "y": "int"
      },
      "button_values": [
        "left",
        "right",
        "middle"
      ]
    },
    "DOUBLE_CLICK": {
      "description": "Doble clic izquierdo (abrir, seleccionar palabra).",
      "params": {
        "x": "int",
        "y": "int"
      }
    },
    "TRIPLE_CLICK": {
      "description": "Triple clic (seleccionar párrafo/línea completa).",
      "params": {
        "x": "int",
        "y": "int"
      }
    },
    "DRAG": {
      "description": "Arrastrar con botón pulsado de un punto a otro (mover, seleccionar por región, slider).",
      "params": {
        "from_x": "int",
        "from_y": "int",
        "to_x": "int",
        "to_y": "int",
        "button": "str",
        "path": "list",
        "modifiers": "list"
      }
    },
    "SCROLL": {
      "description": "Scroll de rueda en una dirección y magnitud (ticks), opcionalmente en un punto.",
      "params": {
        "direction": "str",
        "amount": "int",
        "x": "int",
        "y": "int"
      }
    },
    "TYPE": {
      "description": "Escribir texto literal en el foco de teclado actual.",
      "params": {
        "text": "str"
      }
    },
    "KEY": {
      "description": "Pulsar tecla o combinación (enter, esc, ctrl+s, alt+Tab, down x3...).",
      "params": {
        "keys": "list"
      }
    },
    "HOLD_KEY": {
      "description": "Mantener tecla pulsada durante N ms (aceleración, dash), opcionalmente con acción concurrente.",
      "params": {
        "key": "str",
        "duration_ms": "int",
        "concurrent": "dict"
      }
    },
    "WAIT": {
      "description": "Esperar a que la interfaz termine de cambiar (carga, animación, diálogo).",
      "params": {
        "ms": "int",
        "until": "str",
        "timeout_ms": "int"
      }
    },
    "SCREENSHOT": {
      "description": "Capturar el estado actual de la pantalla para re-observar.",
      "params": {}
    },
    "ZOOM": {
      "description": "Inspeccionar una región a resolución completa (texto pequeño, UI densa).",
      "params": {
        "region": "list",
        "purpose": "str"
      }
    }
  },
